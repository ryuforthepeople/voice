# Copy this file to .env and fill in your API keys

# Deepgram API key (for speech-to-text) - REQUIRED
# Get one at https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-api-key

# === MODE 1: Standalone (direct Claude API) ===
# Anthropic API key (for Claude LLM)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# === MODE 2: Clawdbot (connect to Ryu) ===
# If both are set, Clawdbot mode is used instead of standalone
# CLAWDBOT_GATEWAY_URL=ws://localhost:18789
# CLAWDBOT_TOKEN=your-gateway-token

# Server port (optional)
PORT=3456
